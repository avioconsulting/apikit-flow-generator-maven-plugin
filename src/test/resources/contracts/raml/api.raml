#%RAML 1.0
title: Orders
version: v1
types:
  Order: !include schemas/order.raml
/health:
  get:
    responses:
      200:
/orders:
  /{id}:
    uriParameters:
      id: string
    get:
      responses:
        200:
          body:
            application/json:
              type: Order
              example:
                name: Example order
    post:
      body:
        application/json:
          type: Order
        application/xml:
          type: Order
      responses:
        201:
